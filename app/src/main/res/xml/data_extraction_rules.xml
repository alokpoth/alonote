<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude note database from cloud backup to guarantee 100% offline local privacy -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Allow encrypted device-to-device transfer when user migrates phones -->
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>